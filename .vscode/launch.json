{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: main.py (Remote SSH)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/pi/main.py",
      "cwd": "${workspaceFolder}/src/pi",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1",
        "DISPLAY": ":0",
        "XAUTHORITY": "${env:HOME}/.Xauthority"
      }
    },
    {
      "name": "Python: current file (Remote SSH)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1",
        "DISPLAY": ":0",
        "XAUTHORITY": "${env:HOME}/.Xauthority"
      }
    }
  ]
}
